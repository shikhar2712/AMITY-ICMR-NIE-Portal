From d2092163799fb4b6d70ad126121a61a0cbc9c1b5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 24 Jun 2026 12:10:36 +0000
Subject: [PATCH] CSV export: read Address from address_line (correct DB field)

The enrolment form / DataHandler store the patient address under
'address_line'; the export was reading 'address', so the column was
always blank. Now reads address_line with a fallback to address.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014HDPmuGuqSWsHPmkq6rViq
---
 dashboard.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dashboard.py b/dashboard.py
index 7929f42..902adee 100644
--- a/dashboard.py
+++ b/dashboard.py
@@ -380,7 +380,7 @@ def _build_export_df(recs):
             "Department": r.get('department') or "—",
             "Date of Admission": r.get('date_of_admission') or "—",
             "Patient Name": _patient_name(r) or "—",
-            "Address": r.get('address') or "—",
+            "Address": r.get('address_line') or r.get('address') or "—",
             "Mobile No": r.get('mobile_no') or "—",
             "Lab ID": r.get('lab_id') or "",
             "Age": r.get('age') if r.get('age') not in (None, "") else "—",
